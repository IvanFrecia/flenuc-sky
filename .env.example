# Server
PORT=8080
HOST=0.0.0.0
ENV=development

# Public site URL (for OG tags, Stripe success redirects)
PUBLIC_BASE_URL=http://localhost:8080

# Personal portfolio contact (default: freciaivan@gmail.com)
# CONTACT_EMAIL=freciaivan@gmail.com
# SITE_NAME=Ivan Frecia

# Stripe (leave unset for demo/mock mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: override ledger path (default: /tmp/flenuc-sky-ledger.json on Cloud Run)
# LEDGER_PATH=/tmp/flenuc-sky-ledger.json
